# Ignore virtual environments
.venv/
venv/
env/

# Ignore databases (Keep your local data local!)
*.db
*.sqlite3
*.db-wal
*.db-shm

# Explicit — do not rely on *.db glob for already-tracked files
/gi_database.db
/data-archive/gi_database.*.bak
/data-archive/*.db

# Ignore passwords/secrets
.env
# Every .env VARIANT (.env.local, .env.production, .env.staging …) — the
# audit (A04-F5) found only the bare `.env` covered, and `.env.production` is
# precisely the filename an operator creates while setting up the box.
# `.env.example` is the tracked template, so it is negated back in.
.env.*
!.env.example
.streamlit/secrets.toml
~$*.xlsx

# Key / certificate material. None exists in the tree today — this is
# preventive: certbot writes real private keys on the production host, and any
# local TLS experiment would otherwise drop an unignored .pem/.key here.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Loose backups and logs. `*.bak` is how data-archive/gi_database.*.bak came to
# be tracked in the first place (audit A04-C1).
*.bak
*.log

# Ignore Python cache clutter
__pycache__/
*.pyc

# Attachment store — DB BLOBs are authoritative; disk mirror is local-only.
uploads/

# Phase 6C — CV training artifacts (kept out of git; backed up separately)
models/
data/cv_training/
runs/
yolov8*.pt

# Runtime error logs (developer-facing; not source)
logs/
reports_archive/

# bin/dev.sh scratch: pidfiles + per-component logs for the local dev stack.
.dev/

# bin/backup_db.sh snapshots — pg_dump of `gihub` + a read-only copy of the
# frozen legacy SQLite. Local safety net only; these are full data dumps and
# must never reach the remote.
.backups/

# Same content, without the leading dot. The DBA runs of 2026-08-13 wrote
# pre-wipe and pre-migration pg_dumps here, and the directory was NOT covered
# by the rule above — a full dump of live stock, prices, vendors and staff was
# one `git add -A` away from the remote.
backups/

# Live operational tracking workbooks (operator-owned, synced via
# tools/excel_sync.py — never commit; archived snapshots in data-archive/
# and legacy/scripts/sme_seed_data/ predate this rule and stay tracked).
*.xlsx

# HyperFrames tooling — vendored third-party skill packages, reinstallable with
# `npx skills add heygen-com/hyperframes`. Not part of this project's source.
/.agents/
/.claude/skills/*
# Phase 21e — the reviewed, pinned UI skills are versioned (README inside)
!/.claude/skills/README.md
!/.claude/skills/frontend-design/
!/.claude/skills/webapp-testing/
!/.claude/skills/animate/
!/.claude/skills/review-animations/
!/.claude/skills/find-animation-opportunities/
!/.claude/skills/emil-design-eng/
!/.claude/skills/web-design-guidelines/
/skills-lock.json
/videos/*/.agents/
/videos/*/node_modules/
/videos/*/.hyperframes/
/videos/*/snapshots/
/videos/*/assets/vendor/

# Real PR/PO paperwork dropped in the repo root for OCR calibration
# (QSEP slice 6). These are genuine commercial documents — vendor names,
# prices, contacts — and are read locally to tune the parser, never
# committed. The manuals and SOP PDFs the API serves stay tracked, so the
# pattern is deliberately narrow rather than a blanket *.pdf.
/PO#*.pdf
/PR No *.pdf

# ⚠️ OCR CALIBRATION FIXTURES — THE EXPECTATIONS ARE TRACKED, THE PAGES ARE NOT.
#
# `fixtures/ocr/` holds real signed company paperwork used to measure the vision
# lanes: a delivery note naming a driver and a customer project, a consumables
# register carrying thirty employees' names, a signed consumption form. They are
# read locally and never committed.
#
# `fixtures/ocr_ground_truth.yaml` IS committed, and that is the point of the
# split: the numbers a model is scored against have to be reviewable in a diff,
# or a regression becomes an edit to the expectation. The pattern is narrow so
# that adding a tracked file under fixtures/ later does not require a rule change.
/fixtures/ocr/
# The operator's drop folder for the same documents (PROPOSED_PHASE11_PLAN §7).
/Trail Files/

# Generated by tools/make_ci_fixture_db.py on every CI run and by hand for
# local debugging. Regenerated, never reviewed — it has no business in a diff.
/ci_fixture.db

# ── Phase 12 tutorial renders ───────────────────────────────────────────────
# ⚠️ NEVER COMMITTED, and not only because they are large binaries. Until the
# synthetic tutorial dataset exists (PROPOSED_PHASE12_PLAN.md §3.2), every
# recording is made against the E2E clone of the REAL gi_database.db and can
# carry real employee names and real stock. The tracked artefacts are the YAML
# script and the pipeline; the video is regenerated, never stored.
/docs/tutorials/out/
/tests/video_gen/node_modules
/tests/video_gen/.runtime/
/tests/video_gen/.results/
/tutorial_fixture.db

# Phase 18 (ruling Q5): the operator's BLIND router holdout — lives in the
# GI_ROUTER_HOLDOUT_V2 repository secret, never in git (docs/HOLDOUT_V2_GUIDE.md)
tests/ai_eval/router/security_holdout_v2.yaml

# Phase 21c — the Google Drive OAuth client and its read-only token
# (tools/gdrive_sync.py --auth). Secrets: never committed.
deploy/gdrive_*.json
# Phase 21d — the operator's consumption photos (workers' names) and the
# OCR evaluation cache. Stay on this Mac.
data-archive/ocr_ground_truth/
.cache/ocr_eval/
