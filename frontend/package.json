{
  "name": "frontend",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_TUNNEL=1 VITE_TUNNEL_HOST=local.giinventory.com vite",
    "dev:gi": "VITE_TUNNEL=1 VITE_TUNNEL_HOST=gi.giinventory.com vite",
    "build": "tsc -b && vite build && node scripts/critical_path_check.mjs",
    "lint": "oxlint",
    "parity:sme": "node scripts/sme_parity.mjs",
    "test:ui-math": "node --import ./scripts/register-ts.mjs scripts/sme_ui_math.mjs",
    "test:nav": "node scripts/nav_routes_check.mjs",
    "preview": "vite preview",
    "preview:local": "npm run build && VITE_TUNNEL=1 VITE_TUNNEL_HOST=local.giinventory.com vite preview",
    "preview:gi": "npm run build && VITE_TUNNEL=1 VITE_TUNNEL_HOST=gi.giinventory.com vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "check:critical": "node scripts/critical_path_check.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.2",
    "antd": "^6.5.0",
    "axios": "^1.18.1",
    "jsqr": "^1.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
